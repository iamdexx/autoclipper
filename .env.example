GEMINI_API_KEY=
# narrator voices, tried in this order when set (next one takes over if a call fails / quota runs out)
# Azure Speech resource (Free F0: 500k chars/month) - key + region from "Keys and Endpoint"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Google Cloud API key with Text-to-Speech enabled (Chirp 3 HD, 1M chars/month free)
GOOGLE_TTS_API_KEY=
# ElevenLabs (Liam; 10k chars/month free)
ELEVENLABS_API_KEY=
# or ANTHROPIC_API_KEY= / OPENAI_API_KEY=
YT_CLIENT_SECRETS=secrets/yt_client_secret.json
YT_TOKEN=secrets/yt_token.json
# or, on GitHub Actions: the contents of that file
YT_TOKEN_JSON=
# TikTok: app credentials + the refresh token printed by `autoclipper auth tiktok`
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # SELF_ONLY until the app passes TikTok's audit
# Instagram: long-lived (system user) token + the IG business account id
IG_ACCESS_TOKEN=
IG_USER_ID=
# Instagram downloads the video from a public URL. Either serve data/public/ at PUBLIC_BASE_URL
# yourself, or set the S3-compatible bucket below (Cloudflare R2 / DO Spaces / AWS) and every
# video is uploaded there first.
PUBLIC_BASE_URL=https://clips.example.com
PUBLIC_S3_BUCKET=
PUBLIC_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
PUBLIC_S3_KEY=
PUBLIC_S3_SECRET=
YT_PRIVACY=public
